; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ekosystem_modelowanie"
run/main_scene="res://Scenes/Enviroment/ecosystem.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Types="*res://Globals/Types.gd"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/imjp94.yafsm/plugin.cfg")

[global_group]

Food=""

[layer_names]

2d_navigation/layer_1="Forest"
2d_navigation/layer_2="Desert"
2d_navigation/layer_3="Water"

[rendering]

textures/canvas_textures/default_texture_filter=0
